MONGO_URI=MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/your_database_name
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Embeddings for semantic matching:
#   local  = Sentence-Transformers all-MiniLM-L6-v2 running in Node (downloads ~25 MB once)
#   gemini / openai = hosted embeddings (needs the key below)
#   hash   = offline fallback, no download
EMBEDDING_PROVIDER=local

# Optional LLM for requirement extraction and free-form interview questions.
# Without a key, the built-in rule engine and evidence-driven question generator are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Talent pool data retention (days)
RETENTION_DAYS=365
