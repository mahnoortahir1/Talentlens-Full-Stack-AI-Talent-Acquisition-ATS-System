{
  "name": "talentlens-server",
  "version": "1.0.0",
  "description": "TalentLens API - AI-assisted recruitment & talent intelligence (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "samples": "node scripts/make-sample-pdfs.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:all": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.0.0"
  }
}
